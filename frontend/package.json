{
  "name": "sayumi-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun node_modules/vite/bin/vite.js",
    "build": "bun node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.38",
    "@types/node": "^26.2.0",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.6",
    "solid-js": "2.0.0-rc.6"
  }
}
