{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "bun.lock",
    "bun.lockb",
    "package-lock.json",
    "*.min.js",
    "*.min.css",
    "public/fonts/"
  ]
}
